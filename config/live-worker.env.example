# Copy this file to the repository root as .env.live.local, then fill in the two values below.
HENGYU_API_BASE_URL=https://hengyu-research.vercel.app
HENGYU_INGEST_SECRET=replace-with-the-same-value-configured-in-vercel

# Keep the first local run small. Add comma-separated USD-M symbols only after the chain is verified.
HENGYU_WORKER_SYMBOLS=BTCUSDT
HENGYU_WORKER_DRY_RUN=false

# Optional local overrides.
# HENGYU_WORKER_STATE_FILE=data/live/state.json
# HENGYU_WORKER_PENDING_FILE=data/live/pending-advisories.ndjson
# HENGYU_WORKER_TP_MULTIPLIER=1
# HENGYU_WORKER_ALERT_LEVEL=MEDIUM
