{
  "policyId": "EMAIL_SIGNAL_RELEASE-001",
  "version": 2,
  "purpose": "Govern human-review PAPER_ONLY signal-email release independently from automatic trading.",
  "authorization": {
    "signalOnly": true,
    "paperOnly": true,
    "liveOrdersEnabled": false,
    "accountApi": false,
    "orderApi": false,
    "automaticTrading": false
  },
  "states": [
    "RESEARCH_ONLY",
    "EMAIL_SIGNAL_CANDIDATE",
    "EMAIL_SIGNAL_RELEASE_READY",
    "EMAIL_SIGNAL_RELEASED",
    "EMAIL_SIGNAL_SUSPENDED"
  ],
  "hardGates": {
    "minimumValidatedSignals": 40,
    "minimumValidationDays": 45,
    "baseCostBps": 18,
    "minimumBaseCostNetPnl": 0,
    "minimumNetExpectancyBps": 0,
    "minimumProfitFactor": 1.1,
    "maximumMtmDrawdownPct": 10,
    "minimumDistinctSymbols": 6,
    "maximumLargestSymbolShare": 0.4
  },
  "monthlyRobustness": {
    "rule": "aggregate base-cost net PnL by calendar month, remove the highest-PnL month, and report a non-positive remainder as MONTH_CONCENTRATION_WARNING",
    "requiresValidationDays": 45,
    "noPositiveMonthShareThreshold": true,
    "warningOnly": true
  },
  "warnings": {
    "stressCostBps": 27,
    "stressIsVeto": false,
    "lossStreakWarningAbove": 6,
    "lossStreakIsVeto": false,
    "monthlyConcentrationIsVeto": false
  }
}
